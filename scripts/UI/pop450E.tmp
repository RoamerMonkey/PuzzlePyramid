[node name="Puzzle1" type="Control" parent="Info"]
visible = false
anchors_preset = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="Text" type="Label" parent="Info/Puzzle1"]
layout_mode = 0
offset_left = 194.0
offset_top = 229.0
offset_right = 1248.0
offset_bottom = 899.0
theme_override_colors/font_color = Color(0.0932696, 0.161745, 0.249548, 1)
theme_override_fonts/font = ExtResource("4_ght4d")
theme_override_font_sizes/font_size = 50
text = "Guide the marble through the blind maze using the on-screen arrows or your keyboard’s WASD or arrow keys. The marble icon lights up when it has moved. The blue pieces will light up to indicate which side the marble collided with. If the marble reaches a checkpoint square, it will light up."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Puzzle2" type="Control" parent="Info"]
visible = false
anchors_preset = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="Text" type="Label" parent="Info/Puzzle2"]
layout_mode = 0
offset_left = 194.0
offset_top = 229.0
offset_right = 1248.0
offset_bottom = 899.0
theme_override_colors/font_color = Color(0.0932696, 0.161745, 0.249548, 1)
theme_override_fonts/font = ExtResource("4_ght4d")
theme_override_font_sizes/font_size = 50
text = "Click and drag each circle into the correct square based on matching colors and the row and column’s species features documented by Aster. To know what species a circle represents, place it in the top device to read info about it. Slide the colored squares to get them to the right spots. A square cannot move if it has a circle on it."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Puzzle3" type="Control" parent="Info"]
visible = false
anchors_preset = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="Text" type="Label" parent="Info/Puzzle3"]
layout_mode = 0
offset_left = 194.0
offset_top = 229.0
offset_right = 1248.0
offset_bottom = 899.0
theme_override_colors/font_color = Color(0.0932696, 0.161745, 0.249548, 1)
theme_override_fonts/font = ExtResource("4_ght4d")
theme_override_font_sizes/font_size = 50
text = "Complete five rounds of clicking and dragging each circle to each square to get a sum equal to the displayed goal sum. Each green circle represents a number that can be added to a square’s represented number. Each blue circle nullifies a square’s represented number from being used. When all circles are placed on a square, all the resulting numbers will be summed."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

