offset_top = 193.0
offset_right = 1312.0
offset_bottom = 934.0
theme_override_colors/font_color = Color(0.0932696, 0.161745, 0.249548, 1)
theme_override_fonts/font = ExtResource("4_ght4d")
theme_override_font_sizes/font_size = 50
text = "Complete five rounds of clicking and dragging each circle to each square to get a sum equal to the displayed goal sum.

Each green circle represents a number that can be added to a square’s represented number. Each blue circle nullifies a square’s represented number from being used. When all circles are placed on a square, all the resulting numbers will be summed."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

