extends Control

var config = ConfigFile.new()
func _on_pause_save_button_down() -> void: #save
	config.set_value("game", "location", GlobalStats.location)
	config.set_value("game", "timeleftmin", GlobalStats.timeleftmin)
	config.set_value("game", "timeleftsec", GlobalStats.timeleftsec)
	config.set_value("progress", "firsttime", GlobalStats.firsttime)
	config.set_value("progress", "mg1", GlobalStats.mg1)
	config.set_value("progress", "mg2", GlobalStats.mg2)
	config.set_value("progress", "mg3", GlobalStats.mg3)
	config.set_value("progress", "ho1", GlobalStats.ho1)
	config.set_value("progress", "ho2", GlobalStats.ho2)
	config.set_value("progress", "ho3", GlobalStats.ho3)
	config.set_value("progress", "itemlist", GlobalStats.itemlist)
	config.set_value("settings", "bgm", GlobalStats.bgm)
	config.set_value("settings", "sfx", GlobalStats.sfx)
	config.set_value("settings", "window", GlobalStats.window)
	config.set_value("settings", "cursor", GlobalStats.cursor)
	config.set_value("difficulty", "itemnum", GlobalStats.itemnum)
	config.set_value("difficulty", "mode", GlobalStats.mode)
	config.set_value("difficulty", "maxtime", GlobalStats.maxtime)
	config.set_value("difficulty", "hint", GlobalStats.hint)
	config.set_value("difficulty", "skip", GlobalStats.skip)
	config.set_value("misc", "is_dragging", GlobalStats.is_dragging)
	config.set_value("misc", "zindex", GlobalStats.zindex)
	config.save("user://savegame.cfg")
	$"../Pause/ConfirmSave".visible = true
	$SFXButton.play()

func _on_load_button_down() -> void: #LOAD
	var err = config.load("user://savegame.cfg")
	if err == OK:
		GlobalStats.location = config.get_value("game", "location")
		GlobalStats.timeleftmin = config.get_value("game", "timeleftmin")
		GlobalStats.timeleftsec = config.get_value("game", "timeleftsec")
		GlobalStats.firsttime = config.get_value("progress", "firsttime")
		GlobalStats.mg1 = config.get_value("progress", "mg1")
		GlobalStats.mg2 = config.get_value("progress", "mg2")
		GlobalStats.mg3 = config.get_value("progress", "mg3")
		GlobalStats.ho1 = config.get_value("progress", "ho1")
		GlobalStats.ho2 = config.get_value("progress", "ho2")
		GlobalStats.ho3 = config.get_value("progress", "ho3")
		GlobalStats.itemlist = config.get_value("progress", "itemlist")
		GlobalStats.bgm = config.get_value("settings", "bgm")
		GlobalStats.sfx = config.get_value("settings", "sfx")
		GlobalStats.window = config.get_value("settings", "window")
		GlobalStats.cursor = config.get_value("settings", "cursor")
		GlobalStats.itemnum = config.get_value("difficulty", "itemnum")
		GlobalStats.mode = config.get_value("difficulty", "mode")
		GlobalStats.maxtime = config.get_value("difficulty", "maxtime")
		GlobalStats.hint = config.get_value("difficulty", "hint")
		GlobalStats.skip = config.get_value("difficulty", "skip")
		GlobalStats.is_dragging = config.get_value("misc", "is_dragging")
		GlobalStats.zindex = config.get_value("misc", "zindex")
		$"../Progress/ConfirmLoad".visible = true
	$"../Progress/ConfirmReset".visible = false
	$SFXButton.play()
